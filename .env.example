# Copy to .env and replace every value. Generate random secrets, e.g.:  openssl rand -hex 24
POSTGRES_PASSWORD=
HYPERIOT_ADMIN_PASSWORD=
# at least 32 characters
HYPERIOT_JWT_SECRET=
# the address devices use to reach the platform (OTA download links are built from it)
HYPERIOT_PUBLIC_BASE_URL=http://localhost:8080

# cluster mode only (docker-compose.cluster.yml)
HYPERIOT_MQTT_PASSWORD=
HYPERIOT_HOOK_TOKEN=
EMQX_DASHBOARD_PASSWORD=
